APP_NAME=Affiliate Automation Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
FRONTEND_LOCAL_ORIGIN=http://localhost:3000
FRONTEND_PROD_ORIGIN=https://app.domain.com
# Optional comma-separated allowlist. If set, this takes precedence over the two values above.
FRONTEND_ORIGINS=http://localhost:3000,https://app.domain.com

# Optional local test credentials (loaded on app startup)
CJ_TOKEN=sample
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
WORDPRESS_DOMAIN=
WORDPRESS_WC_CONSUMER_KEY=
WORDPRESS_WC_CONSUMER_SECRET=
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
RENDERFORM_API_KEY=
CLAUDE_API_KEY=

# Branded product images: true = RenderForm API, false = free local Python (Pillow) renderer
USE_RENDERFORM=true
# Claude model used by the GPC automation (review, copy, blogs)
AUTOMATION_CLAUDE_MODELS=claude-haiku-5-5
# CJ account identifiers used by the unattended automation
CJ_COMPANY_ID=6947255
CJ_PID=101105481

# WordPress login for all WP/WooCommerce calls (Application Password); takes precedence over consumer keys
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
